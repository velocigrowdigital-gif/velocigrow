<?xml version="1.0" encoding="UTF-8"?>
<!--
  VelociGrow Digital — Sitemap
  Last updated: 2026-06-22
  Reference: https://www.sitemaps.org/protocols.html
  Notes for Google Search Console:
    - This is a single-page marketing site; only the homepage URL is indexable.
      Fragment URLs (#services, #swiss-offer etc.) are intentionally NOT listed —
      Google ignores fragments in sitemaps and they will be flagged as errors.
    - hreflang alternates are declared below for de-CH / fr-CH / it-CH / en-CH / en-IN.
      Currently all variants point to the same URL because we serve one page;
      when separate translated pages are added, update the <loc> of each variant.
    - Image entries ensure Google Images indexes the logo and portfolio screenshots.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

  <url>
    <loc>https://velocigrow.pages.dev/</loc>
    <lastmod>2026-06-22</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>

    <!-- hreflang alternates — tells Google which language/region each URL serves -->
    <xhtml:link rel="alternate" hreflang="en-ch" href="https://velocigrow.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="de-ch" href="https://velocigrow.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="fr-ch" href="https://velocigrow.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="it-ch" href="https://velocigrow.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="en-in" href="https://velocigrow.pages.dev/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://velocigrow.pages.dev/"/>

    <!-- Images that should appear in Google Image search for Swiss cafe/gym queries -->
    <image:image>
      <image:loc>https://velocigrow.pages.dev/logo.png</image:loc>
      <image:title>VelociGrow — Most Affordable Web Design Agency in Switzerland</image:title>
      <image:caption>Logo of VelociGrow Digital, the most affordable web design agency for cafes and gyms in Switzerland.</image:caption>
      <image:geo_location>Switzerland</image:geo_location>
      <image:license>https://velocigrow.pages.dev/</image:license>
    </image:image>
  </url>

</urlset>